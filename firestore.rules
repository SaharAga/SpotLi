rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper validation functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin allowlist. Mirrored by ADMIN_EMAILS in src/constants/admin.js —
    // that constant only gates the UI; this function is the enforcement.
    // Requires a *verified* email so an unverified self-set address cannot
    // impersonate an admin.
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in ['saharaga97@gmail.com'];
    }

    function isValidPackageData(data, userId) {
      let allowedKeys = [
        'id', 'title', 'titleHe', 'trackingNumber', 'carrier', 'carrierName',
        'status', 'category', 'orderDate', 'expectedDeliveryDate', 'origin',
        'destination', 'notes', 'notesHe', 'isPinned', 'isArchived',
        'checkpoints', 'pickupCode', 'pickupLocation', 'pickupHours', 'pickupPhone',
        'pickupDeadline', 'returnDeadline', 'returnNotes',
        'isRedirected', 'originalPickupLocation', 'redirectedAt', 'redirectReason',
        'store', 'createdAt', 'updatedAt', 'userId'
      ];
      
      let validStatuses = [
        'ordered', 'shipped', 'in_transit', 'customs', 
        'out_for_delivery', 'delivered', 'exception', 'archived'
      ];

      return data.keys().hasOnly(allowedKeys) &&
        data.userId == userId &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        (!('titleHe' in data) || (data.titleHe is string && data.titleHe.size() <= 200)) &&
        data.trackingNumber is string && data.trackingNumber.size() > 0 && data.trackingNumber.size() <= 100 &&
        (!('carrier' in data) || (data.carrier is string && data.carrier.size() <= 50)) &&
        (!('carrierName' in data) || (data.carrierName is string && data.carrierName.size() <= 100)) &&
        data.status is string && data.status in validStatuses &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
        (!('orderDate' in data) || (data.orderDate is string && data.orderDate.size() <= 50)) &&
        (!('expectedDeliveryDate' in data) || (data.expectedDeliveryDate is string && data.expectedDeliveryDate.size() <= 50)) &&
        (!('origin' in data) || (data.origin is string && data.origin.size() <= 150)) &&
        (!('destination' in data) || (data.destination is string && data.destination.size() <= 150)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('notesHe' in data) || (data.notesHe is string && data.notesHe.size() <= 1000)) &&
        (!('pickupCode' in data) || (data.pickupCode is string && data.pickupCode.size() <= 50)) &&
        (!('pickupLocation' in data) || (data.pickupLocation is string && data.pickupLocation.size() <= 250)) &&
        (!('pickupHours' in data) || (data.pickupHours is string && data.pickupHours.size() <= 200)) &&
        (!('pickupPhone' in data) || (data.pickupPhone is string && data.pickupPhone.size() <= 50)) &&
        (!('pickupDeadline' in data) || (data.pickupDeadline is string && data.pickupDeadline.size() <= 50)) &&
        (!('returnDeadline' in data) || (data.returnDeadline is string && data.returnDeadline.size() <= 50)) &&
        (!('returnNotes' in data) || (data.returnNotes is string && data.returnNotes.size() <= 500)) &&
        (!('isRedirected' in data) || data.isRedirected is bool) &&
        (!('originalPickupLocation' in data) || (data.originalPickupLocation is string && data.originalPickupLocation.size() <= 250)) &&
        (!('redirectedAt' in data) || (data.redirectedAt is string && data.redirectedAt.size() <= 50)) &&
        (!('redirectReason' in data) || (data.redirectReason is string && data.redirectReason.size() <= 100)) &&
        (!('store' in data) || (data.store is string && data.store.size() <= 100)) &&
        (!('isPinned' in data) || data.isPinned is bool) &&
        (!('isArchived' in data) || data.isArchived is bool) &&
        (!('checkpoints' in data) || (data.checkpoints is list && data.checkpoints.size() <= 50)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /packages/{packageId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidPackageData(request.resource.data, userId);
        allow update: if isOwner(userId) &&
          isValidPackageData(request.resource.data, userId) &&
          request.resource.data.userId == resource.data.userId;
      }
    }

    // Alpha Tester Feedback Collection
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasOnly([
          'id', 'status', 'type', 'message', 'rating', 'isAnonymous',
          'appVersion', 'buildChannel', 'user', 'userAgent', 'screenWidth',
          'screenHeight', 'timestamp', 'screenshot'
        ]) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 1500 &&
        request.resource.data.id is string &&
        request.resource.data.id.size() > 0 && request.resource.data.id.size() <= 64 &&
        request.resource.data.status is string &&
        request.resource.data.status == 'pending' &&
        request.resource.data.type in ['bug', 'feature', 'praise'] &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.isAnonymous is bool &&
        request.resource.data.isAnonymous == true &&
        request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 30 &&
        request.resource.data.buildChannel is string && request.resource.data.buildChannel.size() <= 30 &&
        request.resource.data.user is string && request.resource.data.user.size() <= 100 &&
        request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300 &&
        request.resource.data.screenWidth is number && request.resource.data.screenWidth >= 0 && request.resource.data.screenWidth <= 10000 &&
        request.resource.data.screenHeight is number && request.resource.data.screenHeight >= 0 && request.resource.data.screenHeight <= 10000 &&
        (!('timestamp' in request.resource.data) || (request.resource.data.timestamp is string && request.resource.data.timestamp.size() <= 60)) &&
        // Optional base64 screenshot. Capped so a single document cannot
        // approach Firestore's 1MiB ceiling and must be an image data URL.
        (!('screenshot' in request.resource.data) || (
          request.resource.data.screenshot is string &&
          request.resource.data.screenshot.size() <= 750000 &&
          request.resource.data.screenshot.matches('^data:image/(png|jpe?g|webp|gif)(;[a-z0-9=_-]+)*;base64,.*')
        ));
      // Readable only by allowlisted admins (the Alpha Feedback Inspector).
      // Still never writable or deletable from any client.
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Automatic anonymous crash reports (src/services/crashReportService.js
    // — ErrorBoundary + window error/unhandledrejection handlers). Kept
    // separate from /feedback deliberately: crash volume is machine-driven
    // and bursty (one bad deploy can generate far more documents than real
    // testers ever submit), so mixing them would let a crash wave crowd out
    // human feedback in the admin inspector's fetch limit. One document per
    // occurrence, same as /feedback; the admin view groups them by
    // signature client-side rather than aggregating server-side, to avoid
    // giving anonymous clients any Firestore update permission.
    match /crashReports/{crashId} {
      allow create: if request.resource.data.keys().hasOnly([
          'id', 'signature', 'componentName', 'message', 'appVersion',
          'buildChannel', 'userAgent', 'screenWidth', 'screenHeight',
          'timestamp'
        ]) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 1500 &&
        request.resource.data.id is string && request.resource.data.id.size() > 0 && request.resource.data.id.size() <= 64 &&
        request.resource.data.signature is string &&
        request.resource.data.signature.size() > 0 &&
        request.resource.data.signature.size() <= 64 &&
        request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 30 &&
        request.resource.data.buildChannel is string && request.resource.data.buildChannel.size() <= 30 &&
        request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300 &&
        request.resource.data.screenWidth is number && request.resource.data.screenWidth >= 0 && request.resource.data.screenWidth <= 10000 &&
        request.resource.data.screenHeight is number && request.resource.data.screenHeight >= 0 && request.resource.data.screenHeight <= 10000 &&
        (!('componentName' in request.resource.data) || (request.resource.data.componentName is string && request.resource.data.componentName.size() <= 100)) &&
        (!('timestamp' in request.resource.data) || (request.resource.data.timestamp is string && request.resource.data.timestamp.size() <= 60));
      // Readable only by allowlisted admins. Never writable or deletable
      // from any client once created — no update means no client can alter
      // or tamper with a report after submitting it.
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Mis-parse correction signal (src/services/parseCorrectionService.js).
    // Records only which fields a user changed after Smart Import auto-filled
    // them, never the field values themselves — deliberately as anonymous and
    // low-stakes as /feedback's write side, so it stays open to guests too
    // (Smart Import works without an account).
    match /parseCorrections/{docId} {
      allow create: if request.resource.data.keys().hasOnly([
          'source', 'confidence', 'editedFields', 'timestamp'
        ]) &&
        request.resource.data.source in ['regex', 'ai'] &&
        (!('confidence' in request.resource.data) || request.resource.data.confidence == null ||
          request.resource.data.confidence in ['high', 'medium', 'low', 'none']) &&
        request.resource.data.editedFields is list &&
        request.resource.data.editedFields.size() > 0 &&
        request.resource.data.editedFields.size() <= 10 &&
        request.resource.data.editedFields.hasOnly([
          'title', 'trackingNumber', 'carrier', 'origin', 'destination', 'notes'
        ]) &&
        (!('timestamp' in request.resource.data) || (request.resource.data.timestamp is string && request.resource.data.timestamp.size() <= 60));
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Opt-in AI training data (src/services/trainingDataService.js). Unlike
    // parseCorrections above, this stores the actual pasted text and
    // before/after field values — only ever written when the owning
    // user has explicitly opted in (users/{uid}.aiTrainingOptIn == true),
    // checked here server-side rather than trusted from the client alone.
    // Deletable (but not updatable) by its own owner: this data has no
    // separate retention timer, its lifetime is the opt-in flag's lifetime
    // (see AuthContext.updateAiTrainingOptIn / deleteUserAccountAndData,
    // which purge it on opt-out and on account deletion respectively).
    match /trainingExamples/{docId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.aiTrainingOptIn == true &&
        request.resource.data.source in ['regex', 'ai'] &&
        (!('confidence' in request.resource.data) || request.resource.data.confidence == null ||
          request.resource.data.confidence in ['high', 'medium', 'low', 'none']) &&
        (!('inputText' in request.resource.data) || (request.resource.data.inputText is string && request.resource.data.inputText.size() <= 5000)) &&
        request.resource.data.initialValues is map &&
        request.resource.data.correctedValues is map &&
        (!('timestamp' in request.resource.data) || (request.resource.data.timestamp is string && request.resource.data.timestamp.size() <= 60));
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // AI-parse usage/rate-limit counters (functions/src/guards.js). Written
    // only by the Cloud Function via the Admin SDK, which bypasses these
    // rules entirely — this block is belt-and-suspenders documentation that
    // no client should ever read or write here (e.g. to fake a lower count
    // and bypass its own rate limit), not the actual enforcement.
    match /usage/{docId} {
      allow read, write: if false;
    }

    // Gmail OAuth connections (functions/src/gmailAuth.js) — refresh
    // tokens and sync cursors for the Gmail auto-sync feature. Written only
    // by Cloud Functions via the Admin SDK, which bypasses these rules
    // entirely; this explicit deny is defense-in-depth documentation that
    // the client SDK must never read or write here (a refresh token must
    // never reach the client).
    match /gmailConnections/{uid} {
      allow read, write: if false;
    }

    // Implicit false-positive signal for the Gmail-sync AI fallback
    // (src/services/aiOutcomeService.js) — the missing half of
    // gmailParseInsights' telemetry: that collection logs what Gemini
    // *said*, this logs whether it was *right*, inferred from the user
    // deleting or correcting a `gmail_sync_ai`-sourced package shortly
    // after it was created. Unlike parseCorrections above (deliberately
    // guest-writable because Smart Import works signed-out), a
    // `gmail_sync_ai` package can only exist for a signed-in user with a
    // connected Gmail account — `source`/`confidence` aren't even in
    // isValidPackageData's allowlist, so the client can't create one
    // itself either — so every legitimate write here is authenticated,
    // and requiring auth (plus binding userId to the caller) closes off
    // unauthenticated spoofing/abuse with no cost to real usage.
    match /gmailAiOutcomes/{docId} {
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'outcome', 'carrier', 'confidence', 'editedFields', 'userId', 'timestamp'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.outcome in ['deleted', 'edited'] &&
        request.resource.data.carrier is string &&
        request.resource.data.carrier.size() <= 40 &&
        (!('confidence' in request.resource.data) || request.resource.data.confidence == null ||
          request.resource.data.confidence in ['high', 'medium', 'low', 'none']) &&
        request.resource.data.editedFields is list &&
        request.resource.data.editedFields.size() <= 2 &&
        request.resource.data.editedFields.hasOnly(['trackingNumber', 'carrier']) &&
        (!('timestamp' in request.resource.data) || (request.resource.data.timestamp is string && request.resource.data.timestamp.size() <= 60));
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Gmail-sync AI fallback rate-limit counters (functions/src/
    // gmailAiFallback.js) — same shape and same "documentation only, Admin
    // SDK bypasses this" rationale as /usage above, kept in its own
    // collection so the Gmail-sync budget is visibly separate from
    // Smart Import's.
    match /gmailAiUsage/{docId} {
      allow read, write: if false;
    }

    // Anonymized hit/miss telemetry for the Gmail-sync detection pipeline
    // (functions/src/gmailAiFallback.js) — sender domain, a truncated
    // subject, and score/confidence bands only, never an email body.
    // Written only by Cloud Functions via the Admin SDK; readable by admins
    // for the same "turn recurring misses into new regex rules" purpose as
    // parseCorrections above.
    match /gmailParseInsights/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Feature-usage analytics events (functions/src/analyticsEvents.js) —
    // append-only counts/outcomes for automated features (Gmail sync
    // today), no PII. Written only by Cloud Functions via the Admin SDK;
    // readable by admins for product-usage review.
    match /usageEvents/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Explicitly deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
