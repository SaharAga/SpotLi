GMAIL_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_PUBSUB_TOPIC=projects/your-project-id/topics/gmail-push
APP_BASE_URL=https://your-app.web.app
GMAIL_OAUTH_REDIRECT_URI=https://us-central1-your-project-id.cloudfunctions.net/gmailOAuthCallback
# Pub/Sub push OIDC auth (pubsubPushAuth.js). Leave unset to keep using the
# legacy ?token= secret; set REQUIRE_OIDC=true once the subscription sends tokens.
GMAIL_PUSH_OIDC_AUDIENCE=https://us-central1-your-project-id.cloudfunctions.net/gmailPushNotification
GMAIL_PUSH_SERVICE_ACCOUNT=gmail-push@your-project-id.iam.gserviceaccount.com
GMAIL_PUSH_REQUIRE_OIDC=false
