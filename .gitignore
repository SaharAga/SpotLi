# Firebase cache
.firebase/

# Agent-to-Agent Local Sync
.agent_sync/
.agent-sync*

# Claude Code: per-machine state stays out, but the SessionStart hook and the
# settings that register it are shared config — they have to be committed or a
# fresh session starts without functions/ dependencies installed.
.claude/*
!.claude/hooks/
!.claude/settings.json
.claude/settings.local.json

# Real user messages pulled for parser evaluation — never committed.
.parser-corpus-real.json
# Derived from a real SMS export off a real phone. Normalized, but not for a
# public repository.
.sms-phrase-report.json
.parser-eval-baseline-real.json

# Firebase service account keys — never commit. Used by scripts/triage_reports.mjs
# and scripts/pull_training_corpus.mjs, which read them from an env var, not from
# a path in the repo.
serviceAccount*.json
service-account*.json
*-firebase-adminsdk-*.json

# Local review of your own messages — never committed.
.message-review.json

strix/
